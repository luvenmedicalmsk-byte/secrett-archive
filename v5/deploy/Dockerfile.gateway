FROM python:3.12-slim

WORKDIR /app
COPY . .

RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    uvicorn[standard]==0.30.1 \
    redis==5.0.7 \
    aiohttp==3.9.5 \
    websockets==12.0

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "gateway.websocket_gateway:app",
     "--host", "0.0.0.0", "--port", "8080",
     "--log-level", "info", "--workers", "1"]
