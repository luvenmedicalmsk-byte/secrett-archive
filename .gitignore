__pycache__/
*.pyc
scripts/__pycache__/

# Точечные экспертизы Tier 1. В записи есть имя клиента, город и разбор
# его личной ситуации, а этот репозиторий ПУБЛИЧНЫЙ: проверено 23.09.2026,
# docs/events.json открывается по raw-ссылке анонимно (HTTP 200).
# Файл нужен генератору PDF локально и в прогоне, но в коммит попасть
# не должен ни при каких условиях. Собранные PDF лежат в docs/reports/,
# который тоже не коммитится и уходит только в приватный репозиторий.
docs/tier1_reports.json

# Документы Tier 1 не должны попасть в публичный репозиторий даже
# случайно. В docs/reports/ уже лежат четыре PDF разборов зон, которые
# туда попали и скачиваются анонимно (проверено 23.09.2026, HTTP 200).
# У разбора зоны это платный продукт, у Tier 1 - персональные данные
# клиента, и цена ошибки другая.
docs/reports/tier1-*.pdf
